#!name=比心去广告
#!desc=移除弹窗广告、悬浮广告、横幅广告、轮播图广告，精简搜索页及我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bixin.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1286964732
#!tag=去广告
#!loon_version=3.5.1(980)
#!homepage=https://hub.kelee.one
#!date=2026-08-28 17:10:45
#!requirement=CORE_VERSION>=6008000

[Body Rewrite]
http-response-jq (?i:^https:\/\/api\.hibixin\.com\/biggie\/home\/v\d\/query\/biggie$) '.result.list |= map(select(has("bannerList") and .bannerList == null))'
http-response-jq (?i:^https:\/\/api\.hibixin\.com\/resource\/v\d\/common\/tab$) '.result |= map(select(.type != "activityCenter"))'

[Map Local]
(?i:^https:\/\/web\.hibixin\.com\/user-recall\/signModal$) data-type=text data="" status-code=404
(?i:^https:\/\/api\.hibixin\.com\/config\/v\d\/common\/popup$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/rec\/card\/query$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.hibixin\.com\/msg\/user\/friends\/trends\/top$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway\.xxqapp\.cn\/live\/pendant\/index\/items$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.xxqapp\.cn\/banner\/list\/\d$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.hibixin\.com\/content\/v\d\/home\/page\/list$) data-type=base64 data="eyJjb2RlIjoiODAwMCIsIm1zZyI6IlNVQ0NFU1MiLCJzdWNjZXNzIjp0cnVlfQ==" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.hibixin\.com\/resource\/v\d\/discovery\/entrance\/activity$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway\.hibixin\.com\/config\/search\/qryConfigPart$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway\.xxqapp\.cn\/live\/flow\/pendant\/meta$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/web-bxyuer\.bixin\.cn\/yuer-ads\?) data-type=text data="" status-code=404
(?i:^https:\/\/gateway\.bxyuer\.com\/official\/room\/tab\/pop$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway\.xxqapp\.cn\/living\/room\/fetch\/recommend-follow-list$) data-type=base64 data="eyJjb2RlIjoiODAwMCIsIm1zZyI6IlNVQ0NFU1MiLCJzdWNjZXNzIjp0cnVlfQ==" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.hibixin\.com\/biggie\/query\/skill\/detail\/relateRecommendBiggieV\d$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[Script]
精简首页标签 = type=http-response, pattern=(?i:^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/common\/tab\/query$), script-path=https://kelee.one/Resource/JavaScript/Bixin/common_tab.js, timeout=20, requires-body=true
精简我的页面 = type=http-response, pattern=(?i:^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/my\/page$), script-path=https://kelee.one/Resource/JavaScript/Bixin/my_page.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% web.hibixin.com, api.hibixin.com, gateway.hibixin.com, gateway.xxqapp.cn, api.xxqapp.cn, web-bxyuer.bixin.cn, gateway.bxyuer.com
