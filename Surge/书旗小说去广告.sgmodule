#!name=书旗小说去广告
#!desc=移除书城横幅广告、听书广告、阅读广告、章末推荐、福利入口、悬浮窗、推荐搜索词，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ShuQiCenterReader.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id733689509
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,render-web.11222.cn,REJECT,extended-matching,pre-matching

[Map Local]
(?i:^https:\/\/huichuan\.sm\.cn\/nativead) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/adV2) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/ocean\.shuqireader\.com\/api\/route\/ios\/readPage$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/ocean\.shuqireader\.com\/api\/render\/load\/resource) data-type=text data="" status-code=404

[Script]
移除书城横幅和阅读广告 = type=http-response, pattern=(?i:^https:\/\/ocean\.shuqireader\.com\/sqios\/render\/render\/page\/bookstore$), script-path=https://kelee.one/Resource/JavaScript/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn
