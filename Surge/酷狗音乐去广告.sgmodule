#!name=酷狗音乐去广告
#!desc=移除开屏广告、应用各类弹窗、各类横幅广告、评论区广告和播放器界面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuGou.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id472208016
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,ads.service.kugou.com,REJECT,extended-matching,pre-matching
DOMAIN,adstats.tencentmusic.com,REJECT,extended-matching,pre-matching
DOMAIN,adsmind.gdtimg.com,REJECT,extended-matching,pre-matching
DOMAIN,adserviceretry.kugou.com,REJECT,extended-matching,pre-matching
DOMAIN,adserviceretry.kglink.cn,REJECT,extended-matching,pre-matching
DOMAIN,ad.tencentmusic.com,REJECT,extended-matching,pre-matching
DOMAIN,adservice.kugou.com,REJECT,extended-matching,pre-matching
DOMAIN,splashimgretrybssdl.cloud.kugou.com,REJECT,extended-matching,pre-matching
URL-REGEX,"^http:\/\/log\.stat\.kugou\.com\/mobile\/ad\.html",REJECT,extended-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/gateway(retry)?\.kugou\.com\/ocean\/v\d\/tab\/list_v\d) 'def namesToRemove:["AI帮唱","长相思2","K歌","小说","游戏"];def removeParentIfNameMatches:if type=="object" then with_entries(select(.value|(type=="object" and (.name as $name|$name|IN(namesToRemove[])|not))))|map_values(removeParentIfNameMatches) else . end;removeParentIfNameMatches'

[Map Local]
(?i:^https:\/\/fx\.service\.kugou\.com\/mfx-kugoulive\/ad\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/adp\/ad\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/ads\.gateway\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/v\d\/feeds\/follow_feed_fallback) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/mstc\/musicsymbol\/v\d\/system\/profile) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/searchnofocus\/v\d\/search_no_focus_word) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/adp\/bubble\/v\d\/song_play) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/singerdiscuss\/v\d\/entrance\/comment) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/r\/v\d\/general\/putin\/midad) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gateway(retry)?\.kugou\.com\/ocean\/v\d\/sound\/banner) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gzacshow\.kugou\.com\/mfanxing-home\/cdn\/room\/index\/list_v2) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/gzacshow\.kugou\.com\/mfx-rt-show\/cdn\/mo\/show\/headline) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/m1fxgroup\.kugou\.com\/fxsing\/yqc\/alongInfo\/getUserAlongInfo) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/hwstore\.kugou\.com\/v\d\/get_store_data) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/ep\.kugou\.com\/v\d\/album_shop\/get_entrance_info) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% gateway.kugou.com, fx.service.kugou.com, hwstore.kugou.com, ep.kugou.com, gatewayretry.kugou.com, gzacshow.kugou.com, m1fxgroup.kugou.com
