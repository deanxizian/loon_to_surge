#!name=快对去广告
#!desc=移除开屏广告、横幅推广，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiDuiZuoYe.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1330927814
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,adx.zuoyebang.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/www\.kuaiduizuoye\.com\/codesearch\/aid\/home$) 'delpaths([["data","homeBannerList"]])'

[Map Local]
(?i:^https:\/\/www\.kuaiduizuoye\.com\/init\/ad\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/www\.kuaiduizuoye\.com\/activity\/init\/checkappconfig$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/www\.kuaiduizuoye\.com\/kdapi\/conf\/appbannersv3$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/www\.kuaiduizuoye\.com\/kdapi\/conf\/initbanner$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/apivip\.kuaiduizuoye\.com\/viponline\/scancode\/mycard$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% www.kuaiduizuoye.com, apivip.kuaiduizuoye.com
