#!name=网易云音乐去广告
#!desc=过滤网易云音乐广告，并允许自定义界面。
#!author=RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NeteaseCloudMusic.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id590338362
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000
#!arguments=MY:false,DT:false,FX:false,PRGG:false,PRRK:false,PRDRD:false,PRSCVPT:false,PRST:false,PRRR:false,HMPR:false,PRMST:false,PRCN:false

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmatapk.nosdn.127.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmusicmat.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,iadmusicmatvideo.music.126.net,REJECT,extended-matching,pre-matching
DOMAIN,ipv4.music.163.com,REJECT,extended-matching,pre-matching
DOMAIN,ipv6.music.163.com,REJECT,extended-matching,pre-matching

[Map Local]
(?i:^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(ocpc\/)?ad\/) data-type=base64 data="" status-code=200 header="Content-Type:text/plain"
(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:delivery\/(batch-)?deliver|moment\/tab\/info\/|side-bar\/mini-program\/music-service\/account|yunbei\/account\/entrance\/)) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:community\/friends\/fans-group\/artist\/group\/|mine\/applet\/redpoint|music\/songshare\/text\/recommend\/|resniche\/position\/play\/new\/|resniche\/tspopup\/show|resource\/comments?\/musiciansaid\/|user\/sub\/artist)) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:ios\/version|mlivestream\/entrance\/playpage\/|link\/position\/show\/strategy|link\/scene\/show\/resource|v1\/content\/exposure\/comment\/banner\/)) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/interface\d?\.music\.163.com\/w?e?api\/search\/default) data-type=base64 data="" status-code=200 header="Content-Type:text/plain"
(?i:^https?:\/\/interface\d?\.music\.163\.com\/w?eapi\/(?:activity\/bonus\/playpage\/time\/query|resource-exposure\/|search\/(?:chart\/|rcmd\/keyword\/|specialkeyword\/))) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/interface\d\.music\.163\.com\/eapi\/my\/podcast\/tab\/recommend) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[Script]
评论区、热推、有话想说、分享一下、歌曲下的祝福等小提示 = type=http-response, pattern=(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:batch|v2\/resource\/comment\/floor\/get)), script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, requires-body=true, binary-body-mode=true
推荐、home、主页 = type=http-response, pattern=(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:homepage\/block\/page|link\/page\/rcmd\/(?:block\/resource\/multi\/refresh|resource\/show))), script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, requires-body=true, binary-body-mode=true, argument="{\"PRGG\":{{{PRGG}}},\"PRRK\":{{{PRRK}}},\"PRDRD\":{{{PRDRD}}},\"PRSCVPT\":{{{PRSCVPT}}},\"PRST\":{{{PRST}}},\"PRRR\":{{{PRRR}}},\"HMPR\":{{{HMPR}}},\"PRMST\":{{{PRMST}}},\"PRCN\":{{{PRCN}}}}"
底部选项卡 = type=http-response, pattern=(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/link\/home\/framework\/tab), script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, requires-body=true, binary-body-mode=true, argument="{\"MY\":{{{MY}}},\"DT\":{{{DT}}},\"FX\":{{{FX}}}}"
发现页 = type=http-response, pattern=(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/link\/page\/discovery\/resource\/show), script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, requires-body=true, binary-body-mode=true
我的页面 = type=http-response, pattern=(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/link\/position\/show\/resource), script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, requires-body=true, binary-body-mode=true
显示未关注你的人 = type=http-response, pattern=(?i:^https?:\/\/interface\d?\.music\.163\.com\/eapi\/user\/follow\/users\/mixed\/get), script-path=https://kelee.one/Resource/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, requires-body=true, binary-body-mode=true

[MITM]
hostname = %APPEND% interface*.music.163.com
