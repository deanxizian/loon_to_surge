#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,adui.tg.meitu.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/api\.posters\.meitu\.com\/common\/init\.json) 'delpaths([["data","vip"]])'

[MITM]
hostname = %APPEND% api.posters.meitu.com
