#!name=百度网盘去广告
#!desc=移除开屏广告、首页卡片广告、传输页面广告、各类弹窗，精简侧拉抽屉和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduNetDisk.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id547166701
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Body Rewrite]
http-response-jq (?i:^https:\/\/pan\.baidu\.com\/feed\/kingkongdistrict\?) '.data.data |= map(select(.type != "novel" and .type != "shortplay" and .type != "print" and .type != "job_hunt"))'

[Map Local]
(?i:^https:\/\/pan\.baidu\.com\/api\/getconfig\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/api\/getsyscfg\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/act\/api\/activityentry\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/api\/plugin\/get\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/recommend\/query\/list\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% pan.baidu.com
