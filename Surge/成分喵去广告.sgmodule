#!name=成分喵去广告
#!desc=移除首页推广活动、广告组件请求、移除被查商品购买链接、搜索发现。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChengFenMiao.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id6444000785
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Body Rewrite]
http-response-jq (?i:^https:\/\/app\.chengfenmiao\.com\/helper\/setting\?) 'delpaths([["detail_buy_sites"]])'
http-response-jq (?i:^https:\/\/app\.chengfenmiao\.com\/helper\/setting\?) 'delpaths([["bottom_sites"]])'

[Map Local]
(?i:^https:\/\/app\.chengfenmiao\.com\/Listing\/LiveHots\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.chengfenmiao\.com\/helper\/VersionCheck\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.chengfenmiao\.com\/item\/closet\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/app\.chengfenmiao\.com\/Helper\/HotWords\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.chengfenmiao.com
