#!name=京东去广告
#!desc=移除京东开屏广告，精简我的页面产品推广。
#!author=RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id414245413
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT,extended-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig) 'if (try (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketEstablishedAhead")) catch false) then (setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0)) else . end'
http-response-jq (?i:^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig) 'if (try (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketReport")) catch false) then (setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0)) else . end'
http-response-jq (?i:^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig) 'if (try (getpath(["data","JDHttpToolKit","httpdns"]) | has("httpdns")) catch false) then (setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0)) else . end'

[Map Local]
(?i:^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[Script]
移除京东广告 = type=http-response, pattern=(?i:^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)), script-path=https://kelee.one/Resource/JavaScript/JD/JD_remove_ads.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com
