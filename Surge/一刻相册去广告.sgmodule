#!name=一刻相册去广告
#!desc=移除开屏广告、横幅广告和弹窗推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduPhoto.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1467852587
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Body Rewrite]
http-response-jq (?i:^https:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?) 'delpaths([["data","service","config","advertisement"]])'
http-response-jq (?i:^https:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?) 'delpaths([["data","service","config","youa","pm_config_ad"]])'

[Map Local]
(?i:^https:\/\/pan\.baidu\.com\/act\/api\/conf\?.*conf_key=youa_core_config_ios) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/pan\.baidu\.com\/youai\/material\/v1\/getbynavid\?.*nav_id=1) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% pan.baidu.com, mbd.baidu.com
