#!name=叮咚买菜去广告
#!desc=移除开屏广告、弹窗推广、搜索推荐、信息流广告、悬浮广告、各页面购物推荐、精简我的页面，移除底栏和各页面AI入口。
#!author=zirawell[https://github.com/zirawell], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], wish
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DingdongMaicai.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id768082524
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,trackercollect.ddxq.mobi,REJECT,extended-matching,pre-matching
DOMAIN,ddfs-public.ddimg.mobi,REJECT,extended-matching,pre-matching
DOMAIN,rttrack.ddxq.mobi,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/categoriesNewDetail\?) 'delpaths([["data","ad_info"]])'
http-response-jq (?i:^https:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig\?) 'delpaths([["data","ai_enter_config"]])'
http-response-jq (?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\?) 'delpaths([["data","top_advert_data"]])'
http-response-jq (?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\?) 'delpaths([["data","suspension"]])'
http-response-jq (?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\?) '.data.list |= map(select(has("capsule_freedom_zone") | not))'
http-response-jq (?i:^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/productApi\/productDetail\/info\?) 'delpaths([["data","detail","chatEntry"]])'
http-response-jq (?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/bottomNavi) 'del(.data.adId?) | if (.data.bottom_list? | length > 0) then .data.bottom_list |= map(select(.type != "eatwhat")) else . end'
http-response-jq (?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/homeFlowDetail) 'walk(if type == "object" and has("list") then .list |= map(if type == "object" and has("multi_advertise_data_list") then del(.multi_advertise_data_list) else . end) else . end)'

[Map Local]
(?i:^https?:\/\/119\.29\.29\.\d+\/d) data-type=text data="" status-code=200
(?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\/) data-type=text data="" status-code=404
(?i:^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop) data-type=text data="" status-code=404
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd\/\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/marketingNotice\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rollHotKeyword\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rankingList\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/search\/hotKeyword\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v1\/user\/queryMyPage\/\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/userLike\/flowData$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% 119.29.29.*, maicai.api.ddxq.mobi, user.api.ddxq.mobi
