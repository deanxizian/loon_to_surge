[Panel]
WARP · INFO = title="WARP · INFO", content="Refresh to query the current Surge route.", style=info, script-name=WARP · INFO

[Script]
WARP · INFO = type=generic, script-path=https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.panel.js, timeout=10

[MITM]
hostname = %APPEND% api.cloudflareclient.com, zero-trust-client.cloudflareclient.com
