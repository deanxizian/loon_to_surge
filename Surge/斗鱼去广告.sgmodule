#!name=斗鱼去广告
#!desc=移除开屏、首页视频流、首页轮播图广告，移除直播间悬浮窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Douyu.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id863882795
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
URL-REGEX,"^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list",REJECT,extended-matching
AND,((DEST-PORT,18000),(PROTOCOL,STUN)),REJECT
DOMAIN,stun1.douyucdn.cn,REJECT,extended-matching,pre-matching
DOMAIN,stun1.qvb.qcloud.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) $1$5$6 307

[Body Rewrite]
http-response-jq (?i:^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list) 'delpaths([["data","pendant_a"]])'
http-response-jq (?i:^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list) 'delpaths([["data","entrance_d"]])'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'if (try (getpath([]) | has("greatGodGameSitterSwitch")) catch false) then (setpath(["greatGodGameSitterSwitch"]; 0)) else . end'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'if (try (getpath([]) | has("followMoreAnchorEntrance")) catch false) then (setpath(["followMoreAnchorEntrance"]; 0)) else . end'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'if (try (getpath([]) | has("sdklivebanner")) catch false) then (setpath(["sdklivebanner"]; 0)) else . end'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'if (try (getpath([]) | has("homeActFloatSwitch")) catch false) then (setpath(["homeActFloatSwitch"]; 0)) else . end'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'if (try (getpath([]) | has("bringGoodsSwitch")) catch false) then (setpath(["bringGoodsSwitch"]; 0)) else . end'
http-response-jq (?i:^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config) 'if (try (getpath([]) | has("qqGameSwitch")) catch false) then (setpath(["qqGameSwitch"]; 0)) else . end'

[Map Local]
(?i:^https:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[Script]
移除首页轮播图和视频流广告 = type=http-response, pattern=(?i:^https:\/\/apiv2\.douyucdn\.cn\/mgapi\/livenc\/home\/getRecV3), script-path=https://kelee.one/Resource/JavaScript/Douyu/Douyu_remove_ads.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn
