[Body Rewrite]
http-response-jq (?i:^https:\/\/userapi\.qiekj\.com\/local-life\/tab-order$) 'if (try (getpath([]) | has("data")) catch false) then (setpath(["data"]; [])) else . end'
http-response-jq (?i:^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsCategoryList$) 'if (try (getpath([]) | has("data")) catch false) then (setpath(["data"]; [])) else . end'

[Map Local]
(?i:^https:\/\/userapi\.qiekj\.com\/slot\/get$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/userapi\.qiekj\.com\/appTitle\/get$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/userapi\.qiekj\.com\/integralRecord\/integralDailStatistics$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/userapi\.qiekj\.com\/local-life\/category$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsPage$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/userapi\.qiekj\.com\/task\/list$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% userapi.qiekj.com
