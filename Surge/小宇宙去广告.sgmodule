[Body Rewrite]
http-response-jq (?i:^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/discovery-feed\/list) '.data |= map(select(.type != "DISCOVERY_HEADER" and .type != "DISCOVERY_BANNER"))'

[Map Local]
(?i:^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.xiaoyuzhoufm.com
