#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id544007664
#!tag=去广告
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000
#!arguments=blockUpload:false,blockShorts:false,blockImmersive:false,captionLang:zh-Hans,debug:false

[Script]
YouTube去广告 = type=http-response, pattern=(?i:^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$), script-path=https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js, timeout=20, requires-body=true, binary-body-mode=true, argument="{\"blockUpload\":{{{blockUpload}}},\"blockShorts\":{{{blockShorts}}},\"blockImmersive\":{{{blockImmersive}}},\"captionLang\":\"{{{captionLang}}}\",\"debug\":{{{debug}}}}"
请求初始化 = type=http-request, pattern=(?i:^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*), script-path=https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, timeout=20, requires-body=true, binary-body-mode=true, argument="{\"captionLang\":\"{{{captionLang}}}\"}"
请求日志事件 = type=http-request, pattern=(?i:^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event), script-path=https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, timeout=20, requires-body=true, binary-body-mode=true, argument="{\"blockUpload\":{{{blockUpload}}},\"blockShorts\":{{{blockShorts}}},\"blockImmersive\":{{{blockImmersive}}},\"captionLang\":\"{{{captionLang}}}\",\"debug\":{{{debug}}}}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
