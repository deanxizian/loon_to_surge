#!name=七猫小说去广告
#!desc=移除大部分七猫小说广告，但受限于七猫小说自身对MitM和VPN状态的检测，部分页面广告无法移除。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1387717110
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,cdn-ad.wtzw.com,REJECT,extended-matching,pre-matching
DOMAIN,cdn-new-ad.wtzw.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdt.qq.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\?) 'delpaths([["data","func_area",1]])'
http-response-jq (?i:^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\?) 'delpaths([["data","func_area",2]])'

[Map Local]
(?i:^https:\/\/api-cfg\.wtzw\.com\/v\d\/splash\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/config) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/push-book) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/operation) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/) data-type=text data="" status-code=404
(?i:^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v\d\/task\/red-packet) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v\d\/reader\/reader-copy-paragraph-all\.json) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api-cfg\.wtzw\.com\/v\d\/reward\/) data-type=text data="" status-code=404
(?i:^https:\/\/api-cfg\.wtzw\.com\/v\d\/adv\/) data-type=text data="" status-code=404
(?i:^https:\/\/api-cfg\.wtzw\.com\/v\d\/offline-adv\/index) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api-cfg\.wtzw\.com\/v\d\/operation\/index\?ad_personal_switch) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/withdraw\/init) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api-cfg.wtzw.com, sf3-fe-tos.pglstatp-toutiao.com, api-bc.wtzw.com, api-gw.wtzw.com, cdn.wtzw.com
