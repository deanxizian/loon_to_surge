#!name=车来了去广告
#!desc=清洗配置，移除开屏广告、首页金刚位、文章推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id667831823
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,ad.chelaile.net.cn,REJECT,extended-matching,pre-matching

[Map Local]
(?i:^https:\/\/api\.chelaile\.net\.cn\/goocity\/flowPos\/home\?) data-type=base64 data="" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.chelaile\.net\.cn\/goocity\/flowPos\/listByPos\?) data-type=base64 data="KipZR0tKe31ZR0tKIyM=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow\/getInfo\?) data-type=base64 data="KipZR0tKe31ZR0tKIyM=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html\?) data-type=text data="" status-code=404
(?i:^https:\/\/image3\.chelaile\.net\.cn\/hw6u6LYY\.png$) data-type=tiny-gif status-code=200
(?i:^https:\/\/api\.chelaile\.net\.cn\/led-weather\/v\d\/condition_brief\?) data-type=base64 data="KipZR0tKe31ZR0tKIyM=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.chelaile\.net\.cn\/goocity\/config\/notices\?) data-type=base64 data="KipZR0tKe31ZR0tKIyM=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/api\.chelaile\.net\.cn\/encourage\/activity\/control\?) data-type=base64 data="KipZR0tKe31ZR0tKIyM=" status-code=200 header="Content-Type:application/json"

[Script]
清洗配置 = type=http-response, pattern=(?i:^https:\/\/api\.chelaile\.net\.cn\/bus-side\/appToggle\/getStatus\?), script-path=https://kelee.one/Resource/JavaScript/Chelaile/Chelaile_remove_ads.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% api.chelaile.net.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, image3.chelaile.net.cn
