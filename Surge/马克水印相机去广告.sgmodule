[Map Local]
(?i:^https:\/\/marki\.markiapp\.com\/mkg\/MomStats\/getFlowWindowList$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https?:\/\/marki\.markiapp\.com\/mkg\/Advertising\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/marki\.markiapp\.com\/mkg\/MomStats\/getIntegralAdv$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/market-callback\.markiapp\.com\/adcenter\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% marki.markiapp.com, market-callback.markiapp.com
