#!name=天气通去广告
#!desc=移除开屏广告、横幅广告、弹窗广告，精简底栏及我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TianQiTong.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id458032309
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Body Rewrite]
http-response-jq (?i:^https:\/\/tqt\.weibo\.cn\/master\/nav\/tab\?) 'map(.tabs|=map(select(.type=="weather" or .type=="radar" or .type=="my")))'

[Map Local]
(?i:^https:\/\/forecast\.sina\.cn\/app\/overall\/switch\.php\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tqt\.weibo\.cn\/business\/advert\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tqt\.weibo\.cn\/user\/device\/ad_multi_star\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tqt\.weibo\.cn\/operation\/activity\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/tqt\.weibo\.cn\/api\/user\/user\/\d\.\d\/\?method=personal_center$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% forecast.sina.cn, tqt.weibo.cn
