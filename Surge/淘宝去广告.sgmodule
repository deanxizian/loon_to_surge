#!name=淘宝去广告
#!desc=过滤淘宝开屏广告
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Taobao.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id387682726
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,adashx.m.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN,ossgw.alicdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ems.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,hudong.alicdn.com,REJECT,extended-matching,pre-matching
DOMAIN,h-adashx.ut.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN,ut.taobao.com,REJECT,extended-matching,pre-matching

[Map Local]
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict)) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[Script]
移除淘宝开屏广告 = type=http-response, pattern=(?i:^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)), script-path=https://kelee.one/Resource/JavaScript/Taobao/Taobao_remove_ads.js, timeout=20, requires-body=true
移除淘宝开屏广告 = type=http-response, pattern=(?i:^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json), script-path=https://kelee.one/Resource/JavaScript/Taobao/Taobao_remove_ads.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% acs.m.taobao.com, heic.alicdn.com, guide-acs.m.taobao.com, poplayer.template.alibaba.com
