#!name=网易有道词典去广告
#!desc=移除开屏广告、弹窗广告、右上角推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YoudaoDict.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id353115739
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Rule]
DOMAIN,ad-sdk-config.youdao.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
http-response-jq (?i:^https:\/\/dict\.youdao\.com\/homepage\/toolbar\/get\/) 'delpaths([["data","vipTag"]])'

[Map Local]
(?i:^https:\/\/dict\.youdao\.com\/vip\/activity\/startup\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/dict\.youdao\.com\/vip\/activity\/retention\/configs\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/dict\.youdao\.com\/vip\/activity\/retention\/match\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/dict\.youdao\.com\/vip\/user\/paid\/guide\?) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% dict.youdao.com
