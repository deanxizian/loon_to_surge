#!name=网易邮箱大师去广告
#!desc=移除网易邮箱大师开屏广告、签到任务提醒，精简侧拉抽屉和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MailMaster.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id897003024
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=6008000

[Body Rewrite]
http-response-jq (?i:^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/v2\/conf\.do$) 'delpaths([["data","functionOperatorInfoList"]])'
http-response-jq (?i:^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/v2\/conf\.do$) 'delpaths([["data","memberOperator"]])'
http-response-jq (?i:^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/v2\/conf\.do$) 'delpaths([["data","activityTabInfoList"]])'
http-response-jq (?i:^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do$) '.data.config[] |= if .result.tools then .result.tools |= map(select(.name == "邮件追踪" or .name == "替身邮箱")) else . end | del(.data.config[] | select(.functionName == "Function-AD"))'

[Map Local]
(?i:^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/dashi\.163\.com\/task-center-api\/fapi\/task\/list$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/appconf\.mail\.163\.com\/mailoperating\/mailmaster\/api\/operator\/get$) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% appconf.mail.163.com, dashi.163.com
