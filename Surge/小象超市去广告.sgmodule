[Map Local]
(?i:^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/splash) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/bubble\/operate\/info) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/mall\.meituan\.com\/api\/c\/jigsaw\/code\/category-banner-\d+\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/order\/recommend\/v\d) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/mall\.meituan\.com\/api\/c\/banner\/) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/personal\/recommend) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"
(?i:^https:\/\/businessapi\.ksedt\.com\/signupindex\/jxlist) data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json"

[Script]
移除下发广告 = type=http-response, pattern=(?i:^https:\/\/portal-portm\.meituan\.com\/horn_ios\/mergeRequest), script-path=https://kelee.one/Resource/JavaScript/iMaiCai/iMaiCai_remove_ads.js, timeout=20, requires-body=true

[MITM]
hostname = %APPEND% portal-portm.meituan.com, mall.meituan.com, businessapi.ksedt.com
